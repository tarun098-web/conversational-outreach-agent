APP_ENV=development
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-before-production

# The safe defaults make the demo entirely local and consume no API tokens.
AI_PROVIDER=mock
EMAIL_PROVIDER=mock
STORAGE_PROVIDER=memory

# Groq is invoked only when an inbound email or explicit regeneration/evaluation occurs.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b

SUPABASE_URL=
SUPABASE_KEY=

# Gmail OAuth files should live outside Git and may be placed in .runtime/.
GMAIL_CREDENTIALS_PATH=.runtime/credentials.json
GMAIL_TOKEN_PATH=.runtime/token.json
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# No polling loop is started. Gmail Pub/Sub or POST /api/v1/messages/inbound triggers work.
ENABLE_BACKGROUND_POLLING=false
MAX_CONTEXT_MESSAGES=20
REQUIRE_HUMAN_APPROVAL=true
LOG_LEVEL=INFO

